---
layout: layouts/base.njk
---
<section class="page-hero"><p class="eyebrow light">Find us in Eleme</p><h1>Come worship with us.</h1><p>{{ content | safe }}</p></section><section class="contact-layout content-width"><div><p class="eyebrow">Your visit</p><h2>We are here to welcome you.</h2><p>{{ settings.address_line1 }}, {{ settings.address_line2 }}, {{ settings.address_city }}, Nigeria.</p><a class="button button-accent" href="https://www.google.com/maps/search/?api=1&query={{ settings.map_query | urlencode }}" target="_blank" rel="noopener noreferrer">Open directions ↗</a><div class="contact-methods"><h3>Get in touch</h3><p><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>{% if settings.phone and settings.phone != '+234' %}<p><a href="tel:{{ settings.phone }}">{{ settings.phone }}</a></p>{% endif %}</div></div><div class="map-frame"><iframe title="Map showing the church location in Eleme" src="https://www.google.com/maps?q={{ settings.map_query | urlencode }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><p>Map location is based on the address entered by the church administrator. Please confirm the pin before publishing.</p></div></section>
