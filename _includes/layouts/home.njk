---
layout: layouts/base.njk
---
<section class="hero" aria-label="Welcome to MFM Eleme">
<div class="hero-media" style="background-image:url('{{ hero_video_poster }}')">
{% if hero_videos and hero_videos.length %}<div class="hero-video-playlist" aria-hidden="true" data-hero-playlist>{% for clip in hero_videos %}{% if clip.url %}<span data-video-src="{{ clip.url }}"></span>{% endif %}{% endfor %}</div><video class="hero-video is-active" autoplay muted playsinline preload="auto" poster="{{ hero_video_poster }}" aria-hidden="true"></video><video class="hero-video" muted playsinline preload="auto" poster="{{ hero_video_poster }}" aria-hidden="true"></video>{% elif hero_video_url %}<video autoplay muted loop playsinline preload="metadata" poster="{{ hero_video_poster }}" aria-hidden="true"><source src="{{ hero_video_url }}" type="video/mp4"></video>{% endif %}
</div><div class="hero-shade"></div><div class="hero-inner"><p class="eyebrow light">Mountain of Fire and Miracles Ministries · Eleme</p><h1>Welcome to a place of <em>Deep Worship,Word, Prayer, Deliverance & Prophetic Encounter.</em></h1><p class="hero-copy">{{ settings.welcome_text }}</p><div class="hero-actions"><a class="button button-accent" href="/contact/">Plan your visit <span aria-hidden="true"></span></a><a class="button button-outline" href="/live/">Join us live</a></div></div>
</section>
<section class="intro content-width" aria-labelledby="intro-title"><div><p class="eyebrow">You belong here</p><h2 id="intro-title">There is room for you at the mountain.</h2></div><div><p>Join us in Eleme for heartfelt worship, the Word of God and prayer. Whether this is your first visit or you worship with us every week, we are glad you are here.</p><a class="text-link" href="/who-we-are/">Get to know us <span aria-hidden="true"></span></a></div></section>
<section class="heritage-strip" aria-labelledby="heritage-title"><div class="content-width heritage-inner"><div><p class="eyebrow">Rooted in MFM Worldwide</p><h2 id="heritage-title">A Region on a worldwide mountain.</h2><p>Discover the ministry behind MFM Eleme and meet the General Overseer and his wife.</p></div><div class="heritage-links"><a href="/who-we-are/">Explore who we are</a><a href="/leadership/">Read the G.O. and his wife’s biographies</a></div></div></section>
<section class="gatherings" id="worship"><div class="content-width"><div class="section-heading"><div><p class="eyebrow">Come together</p><h2>Gather with us</h2></div><p>Find a time to worship, pray and connect.</p></div><div class="gathering-grid"><article class="gathering-card"> IN PERSON</span><h3>Services at Eleme</h3>{% for s in settings.services %}<p>{{ s.text }}</p>{% endfor %}<a class="text-link" href="/contact/">Get directions </a></article><article class="gathering-card dark-card" ONLINE</span><h3>Prayer & broadcasts</h3>{% for b in settings.broadcasts %}<p>{{ b.text }}</p>{% endfor %}<a class="text-link" href="/live/">Watch online </a></article></div></div></section>
<section class="gallery-section content-width" aria-labelledby="gallery-title"><div class="section-heading"><div><p class="eyebrow">Life at MFM Eleme</p><h2 id="gallery-title">Our church, in moments</h2></div><a class="text-link" href="/gallery/">View the gallery </a></div><p class="section-intro">{{ gallery_intro }}</p><div class="gallery-grid">{% for g in gallery %}{% if loop.index <= 5 %}<a href="/gallery/" class="gallery-tile"><img src="{{ g.image }}" alt="{{ g.alt or 'Church gathering at MFM Eleme' }}" loading="lazy"></a>{% endif %}{% endfor %}</div></section>
<section class="visit-strip"><div class="content-width visit-strip-inner"><div><p class="eyebrow light">We would love to see you</p><h2>Find your way to us.</h2><p>{{ settings.address_line2 }}, {{ settings.address_city }}</p></div><a class="button button-accent" href="/contact/">Plan your visit </a></div></section>
