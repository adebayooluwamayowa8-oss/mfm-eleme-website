---
layout: layouts/base.njk
---
<section class="page-hero">
  <h1>{{ title }}</h1>
</section>
<section class="page-body">
  <div class="page-body-inner">
    {{ content | safe }}

    {% if links and links.length %}
    <h2 class="links-heading">Links &amp; Documents</h2>
    <ul class="links-list">
      {% for link in links %}
      <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>
