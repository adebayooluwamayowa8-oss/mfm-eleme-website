<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#47122d">
<meta name="description" content="{{ settings.description }}">
<title>{% if title == 'Home' %}{{ settings.site_name }}{% else %}{{ title }} | {{ settings.site_name }}{% endif %}</title>
<link rel="icon" href="{{ settings.logo }}"><link rel="stylesheet" href="/css/style.css">
</head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="header-row">
<a href="/" class="brand" aria-label="{{ settings.site_name }} home"><img src="{{ settings.logo }}" alt="" width="50" height="50"><span><strong>{{ settings.site_name }}</strong><small>South-South 6 · Eleme</small></span></a>
<button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav"><span></span><span></span><span></span></button>
<nav id="mainNav" aria-label="Main navigation"><ul>
<li><a href="/">Home</a></li><li><a href="/who-we-are/">About</a></li><li><a href="/leadership/">Our G.O.</a></li><li><a href="/what-we-do/">Ministries</a></li><li><a href="/sermons/">Sermons</a></li><li><a href="/gallery/">Gallery</a></li><li><a href="/resources/">Resources</a></li><li><a href="/giving/">Giving</a></li><li><a href="/contact/">Visit us</a></li>
</ul><a class="nav-live" href="/live/">Watch live</a></nav>
</div></header>
<main id="main">{{ content | safe }}</main>
<footer class="site-footer"><div class="footer-inner"><div><img src="{{ settings.logo }}" alt="" width="48" height="48"><h2>{{ settings.site_name }}</h2><p>{{ settings.tagline }}</p><p>{{ settings.welcome_text }}</p></div><div><h2>Explore</h2><a href="/who-we-are/">About the church</a><a href="/leadership/">Our G.O. and his wife</a><a href="/live/">Watch live</a><a href="/sermons/">Messages</a><a href="/gallery/">Photo gallery</a><a href="/giving/">Give</a></div><div><h2>Visit & connect</h2><p>{{ settings.address_line2 }}, {{ settings.address_city }}</p>{% if settings.phone and settings.phone != '+234' %}<a href="tel:{{ settings.phone }}">{{ settings.phone }}</a>{% endif %}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a><div class="footer-social" aria-label="Social media">
{% if settings.youtube %}<a href="{{ settings.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube"><img src="/images/social/youtube.png" alt="" width="24" height="24" loading="lazy"></a>{% endif %}
{% if settings.facebook %}<a href="{{ settings.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook"><img src="/images/social/facebook.png" alt="" width="24" height="24" loading="lazy"></a>{% endif %}
{% if settings.tiktok %}<a href="{{ settings.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok"><img src="/images/social/tiktok.png" alt="" width="24" height="24" loading="lazy"></a>{% endif %}
{% if settings.instagram %}<a href="{{ settings.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"><img src="/images/social/instagram.png" alt="" width="24" height="24" loading="lazy"></a>{% endif %}
</div></div></div><div class="footer-bottom">© 2026 {{ settings.site_name }}</div></footer>
<dialog id="photoViewer" class="photo-viewer" aria-label="Photo viewer"><div class="photo-viewer-inner"><button type="button" class="viewer-close" aria-label="Close photo">✕</button><button type="button" class="viewer-arrow viewer-prev" aria-label="Previous photo">‹</button><figure><img id="viewerImage" alt=""><figcaption id="viewerCaption"></figcaption></figure><button type="button" class="viewer-arrow viewer-next" aria-label="Next photo">›</button><span class="viewer-count" aria-live="polite"></span></div></dialog>
<script src="/js/main.js" defer></script></body></html>
