<section class="page-hero"><p class="eyebrow light">Life at MFM Eleme</p><h1>Our photo gallery</h1><p>Moments of faith and fellowship.</p></section>
<section class="gallery-page content-width" aria-label="Church photos"><div class="gallery-page-grid">{% for g in collections.all %}{% if g.url == '/' %}{% for photo in g.data.gallery %}<figure class="gallery-card"><button type="button" class="gallery-photo" data-gallery-photo aria-label="View larger photo: {{ photo.alt or 'Church gathering at MFM Eleme' }}"><img src="{{ photo.image }}" alt="{{ photo.alt or 'Church gathering at MFM Eleme' }}" loading="lazy"><span class="gallery-zoom" aria-hidden="true">View photo ↗</span></button><figcaption>{{ photo.alt or 'MFM Eleme church family' }}</figcaption></figure>{% endfor %}{% endif %}{% endfor %}</div></section>
